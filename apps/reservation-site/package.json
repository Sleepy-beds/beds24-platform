{
  "name": "@sleepy-beds/reservation-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hono + React 宿泊予約サイト — @sleepy-beds プラットフォーム（Beds24 + Stripe + Resend + LINE）を利用したリファレンス実装。",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@sleepy-beds/beds24-booking-sdk": "workspace:*",
    "@sleepy-beds/beds24-line": "workspace:*",
    "@sleepy-beds/beds24-sdk": "workspace:*",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "stripe": "^17.5.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "resend": "^4.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
