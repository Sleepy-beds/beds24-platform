# ============================================================
# reservation-site environment
# 何も設定しなければ「モックモード」で起動します（外部サービス不要）。
# 本番に繋ぐときだけ、各セクションを実値で埋めてください。
# ============================================================

# --- サーバ ---
PORT=8787
# Stripe Checkout の戻り先などに使う公開URL（本番は https://… のドメイン）
PUBLIC_BASE_URL=http://localhost:5173

# --- 施設情報（UI表示・料金計算に使用。クライアントごとに編集） ---
PROPERTY_NAME=サンプル宿
PROPERTY_NAME_EN=Sample Inn
PROPERTY_ADDRESS=東京都〇〇区〇〇 1-2-3
PROPERTY_PHONE=03-0000-0000
PROPERTY_MAX_GUESTS=6
PROPERTY_CHECKIN_TIME=15:00
PROPERTY_CHECKOUT_TIME=10:00
PROPERTY_BASE_PRICE=15000
PROPERTY_WEEKEND_PRICE=18000
PROPERTY_EXTRA_GUEST_THRESHOLD=2
PROPERTY_EXTRA_GUEST_SURCHARGE=3000
PROPERTY_MAX_STAY_NIGHTS=14
PROPERTY_VALID_CHECKIN_TIMES=15:00,16:00,17:00,18:00,19:00

# --- Beds24（Settings → Apis → Token で発行） ---
# 設定するとカレンダー/在庫/予約が実APIになります。
BEDS24_REFRESH_TOKEN=
BEDS24_PROPERTY_ID=
BEDS24_ROOM_ID=

# --- Stripe（決済） ---
# secret + webhook の両方を設定すると Stripe Checkout が有効になります。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Resend（確認メール。任意） ---
RESEND_API_KEY=
EMAIL_FROM=予約 <booking@example.com>
EMAIL_OWNER=owner@example.com
EMAIL_REPLY_TO=

# --- LINE 通知（任意・差別化機能）。設定すると予約成立時に push されます ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=
